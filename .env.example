# =====================================================================
#  Hub Studenti — configurazione. Copia questo file in ".env" e modificalo.
#  Il file .env contiene segreti: NON caricarlo mai su Git (è già nel .gitignore).
#  Tutti i valori hanno un default: per provare in locale non serve cambiare nulla.
# =====================================================================

# --- Server ---
PORT=3000
HOST=0.0.0.0
# Indirizzo pubblico del sito, SENZA slash finale (finisce nei link delle email). In produzione: https://...
BASE_URL=http://localhost:3000
# Metti true se il sito sta dietro a un reverse proxy (Caddy, nginx, Cloudflare Tunnel…)
TRUST_PROXY=false
NODE_ENV=development

# --- Registration rules ---
# Schools are created with: npm run admin -- school-create "Name" [@optional-email-domain]
# Users join a school with its invite code and use their own email address.
PASSWORD_MIN=8
# AGPL-3.0 section 13: public link to the source code of the version you run (shown in the footer)
SOURCE_URL=https://github.com/0xn0rm41/hub-studenti

# --- Data controller (GDPR): shown in the privacy notice. Use the operator running the service ---
TITOLARE_NOME=
TITOLARE_CONTATTO=
# DPO contact, if you have one (optional)
DPO_CONTATTO=
# Aumenta questo valore se cambi in modo sostanziale informativa o regole
VERSIONE_INFORMATIVA=2026-10

# --- Email (conferma account e recupero password) ---
# Senza SMTP_HOST i link vengono scritti nella console del server (va bene per provare, NON per la produzione)
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
MAIL_FROM="Hub Studenti <no-reply@your-domain.example>"

# --- Conservazione dei dati (GDPR: limitazione della conservazione) ---
SESSIONE_GIORNI=14
RITENZIONE_NON_VERIFICATI_GIORNI=3
# Account senza accessi da N mesi vengono cancellati (0 = mai: sconsigliato, vedi docs/eu/gdpr/GDPR.md)
RITENZIONE_INATTIVI_MESI=12
RITENZIONE_BACKUP_GIORNI=30

# --- Regole della piattaforma (valori iniziali; poi si cambiano con: npm run admin -- set ...) ---
SOGLIA_IDEE=30
# 0 = no commission (default). A value > 0 only shows an indicative calculation: no money moves through the platform.
COMMISSIONE_PERCENTUALE=0

# --- Avanzate ---
# Registrazioni consentite ogni ora da uno stesso IP (una scuola può stare dietro a un solo IP: alza il valore se serve)
REGISTRAZIONI_ORA_PER_IP=20
# Cartella dei dati (database + foto + backup). Default: ./data
# DATA_DIR=data
